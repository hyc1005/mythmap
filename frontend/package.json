{
  "name": "shanhai-map-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:narrative": "node scripts/verify-narrative.mjs",
    "verify:locale": "node scripts/verify-locale.mjs",
    "verify:layout": "node -e \"process.env.ATLAS_LAYOUT_ONLY='1';import('./scripts/verify-narrative.mjs')\"",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:exploration": "node scripts/verify-exploration.mjs",
    "verify:publish": "node scripts/verify-publish.mjs",
    "verify:cache": "node scripts/verify-cache.mjs",
    "verify:repairs": "node scripts/verify-repairs.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:resume": "node scripts/verify-resume.mjs",
    "verify:reading": "node scripts/verify-reading.mjs",
    "verify:guided-tour": "node scripts/verify-guided-tour.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "verify:preview": "node scripts/with-preview.mjs -- node scripts/verify-design.mjs",
    "preview:managed": "node scripts/with-preview.mjs --port 4183"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@remotion/player": "4.0.532",
    "ol": "^10.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "vite": "^6.3.5"
  }
}
