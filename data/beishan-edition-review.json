  "commentary_alignment": [
    {
      "source_unit_ids": [
        "source-03-0002",
        "source-03-0003"
      ],
      "reading": "机木似榆可燒以糞稲田出蜀中音飢",
      "basis": "76页机木双行小注的音与飢连读；音逢另属漨水，捕获快照不改。"
    },
    {
      "source_unit_ids": [
        "source-03-0007",
        "source-03-0008",
        "source-03-0009",
        "source-03-0010"
      ],
      "basis": "0005—0009均见76页，0009牛尾及水马郭注捕获为77页，按影印校回76；0010其音如呼及注见77页，0011帶山另段。0008音吾子之吾回释前句梧，不归水馬；疣贅也释滑魚食用句。諸毗山只在郭注出现，单独作注文地点，不与西山同名山合并。周禮马黑脊等引文为比拟，不追加本段黑背特征；水马注录文省字或异写保留，非逐字校勘定本。"
    },
    {
      "source_unit_ids": [
        "source-03-0011",
        "source-03-0012",
        "source-03-0013",
        "source-03-0014",
        "source-03-0015",
        "source-03-0016"
      ],
      "basis": "0011—0016全核77页，0017譙明另段。䑏䟽一角有錯与郭注甲錯分列；鵸䳜注上已、有此鳥疑同名跨13—14连读，不合并西山三首六尾。儵魚郭注音由，英文采用Youyu，中文与稳定ID保留；不改为普通鱼形。"
    },
    {
      "source_unit_ids": [
        "source-03-0017",
        "source-03-0018",
        "source-03-0019",
        "source-03-0020",
        "source-03-0021"
      ],
      "basis": "0017—0018均见77页末，0018虽捕获78页仍校回77；0019—0021在78页。孟槐貆的豪猪释义来自郭注，不画成正文另称豪猪。多青与雄黄跨行连读，按青雄黄整项留歧义，一作多青碧另列，不擅改底本。"
    },
    {
      "source_unit_ids": [
        "source-03-0022",
        "source-03-0023",
        "source-03-0024",
        "source-03-0025"
      ],
      "basis": "0022—0025全核78页。鰼鰼十翼、鳞在羽端及鹊状同时保留，不据鱼名补鱼尾。㯶、栢、橿依底本；麢羊仅列名，蕃注未詳或云即鴞仍为不确定注说，二者用统一占位。"
    },
    {
      "source_unit_ids": [
        "source-03-0026",
        "source-03-0027",
        "source-03-0028",
        "source-03-0029"
      ],
      "basis": "0026—0027在78页，0027捕获79校回78；79页从注于河及橐駝续。桐梧与桐也跨26—27连读，后句椐樻木腫節中椐桾音祛独归椐，疑难用字不强解。橐駝注有肉鞍等不足决定驼峰数量，暂留占位；寓鼠状鸟翼有明确依据才生图。"
    },
    {
      "source_unit_ids": [
        "source-03-0030",
        "source-03-0031"
      ],
      "basis": "0030—0031全核79页，0032丹熏另段。魚水为水名，不将鱼字算作本段新增鱼类；文貝仅列名、玉与无石并存保留。河复用北山本批共享索引，四段摘句各存出处，不与西山河索引或现代河道合并。"
    },
    {
      "source_unit_ids": [
        "source-03-0032",
        "source-03-0033",
        "source-03-0034",
        "source-03-0035",
        "source-03-0036"
      ],
      "basis": "0032—0036全在79页，0036百毒捕获80校回79。皆山果爾雅有其名为捕获注文，所指不强解。正文莬首、以其尾飛保留；配图兔形首为艺术解释，或作髯飛属郭注异文，不并入正文。䐆大腹也与獋音豪分列。"
    },
    {
      "source_unit_ids": [
        "source-03-0037",
        "source-03-0038",
        "source-03-0039"
      ],
      "basis": "0037—0039全核80页，0040邊春另段。文題白身不可读成全身豹斑；題額也为郭注。河复用本篇共享索引，新增泚水出处，不与西山或现代河道合并。"
    },
    {
      "source_unit_ids": [
        "source-03-0040",
        "source-03-0041",
        "source-03-0042",
        "source-03-0043"
      ],
      "basis": "0040—0043全核80页。春山异名、葱茖大叶、桃小不解核、幽鴳佯眠与嬻嬒异文分开；不据鴳字补鸟形。杠水与后文櫟水相接，泑澤单设北山索引，不混單狐泑水和西山泑澤。"
    },
    {
      "source_unit_ids": [
        "source-03-0044",
        "source-03-0045",
        "source-03-0046",
        "source-03-0047"
      ],
      "basis": "0044—0045在80页，0045捕获81校回80；0046—0047在81页。足与訾跨页合名；足訾文臂、牛尾、马蹄分别核对。朋猶軰是郭注，群飞写入内容，鵁单体配图不冒充群景；音义注文的渇等疑字依捕获另存，不强解异文；雌雉羽色不借白鵺白翼黄足。"
    },
    {
      "source_unit_ids": [
        "source-03-0048",
        "source-03-0049",
        "source-03-0050",
        "source-03-0051",
        "source-03-0052",
        "source-03-0053"
      ],
      "basis": "0048—0053全核81页，0054灌題另段。諸犍复用既有稳定ID和图，保留旧篇目锚点，补本山出处；㗸字依捕获，不改写快照。嗌咽也谷梁傳曰嗌与下单元不容粒等连读；痸癡病也为古注，不按现代病种认定。櫟水南流不误作西流。"
    },
    {
      "source_unit_ids": [
        "source-03-0054",
        "source-03-0055",
        "source-03-0056",
        "source-03-0057",
        "source-03-0058"
      ],
      "basis": "0054在81页末，捕获82校回81；0055—0058在82页。訆的如人呼喚与音呌跨单元分别回释，不归竦斯。躍跳为郭注。磁石取铁与管子说山下有铜均为古注，不换算现代矿点；泑澤复用北山索引。"
    },
    {
      "source_unit_ids": [
        "source-03-0059",
        "source-03-0060",
        "source-03-0061",
        "source-03-0062"
      ],
      "basis": "0059—0062全在82页，0062澤为邊水所注櫟澤的续字；0063小咸另段。四節生毛属正文，背膝及胡尾长毛属郭注，不互相替代。北山旄牛不借西山翠山图，櫟澤不按櫟字合并櫟水。"
    },
    {
      "source_unit_ids": [
        "source-03-0063"
      ],
      "basis": "0063整句在82页末，捕获83校回82。0064北二百八十里另起大咸，虽无又字仍须独立；小咸与0072少咸不混名。冬夏有雪只作本山记述，不推定现代气候数据。"
    },
    {
      "source_unit_ids": [
        "source-03-0064",
        "source-03-0065",
        "source-03-0066",
        "source-03-0067"
      ],
      "basis": "0064—0067全核83页。皷与柝跨行连读为一种声响描述，0068敦薨另段。郭注長与百尋跨65—66相接；蝮蛇艾綬文及常山长蛇形不同属于比拟，不替正文补定长度、花纹或另一蛇形。"
    },
    {
      "source_unit_ids": [
        "source-03-0068",
        "source-03-0069",
        "source-03-0070",
        "source-03-0071"
      ],
      "basis": "0068—0071全在83页，0072少咸始于本页末但留下一阶段。赤鮭注文音与下一单元圭连读，英文Gui据此，不译成现代鲑鱼。出于崑崙东北隅实惟河源原句保留，河源古述与郭注即河水出崑崙之虚分开；撲牛异文所指保留疑义，不强配某兽。四个形貌不足生物用占位，不借潘侯旄牛或西山兕图。"
    },
    {
      "source_unit_ids": [
        "source-03-0072",
        "source-03-0073",
        "source-03-0074",
        "source-03-0075"
      ],
      "basis": "0072在83页末，捕获84校回83；0073—0075在84页。少咸不混小咸，敦水不混敦薨水。窫窳马足与郭注尔雅虎爪异说分列；䰽郭注未详或作鯆不足补定形貌，留占位。鴈門山间为郭注地点，不加现代坐标。"
    },
    {
      "source_unit_ids": [
        "source-03-0076",
        "source-03-0077",
        "source-03-0078",
        "source-03-0079"
      ],
      "basis": "0076—0079全核84页，0080北嶽另段。瀤音懐、䲃音藻、𤟤音暉、行风言疾各归其词。善投不据此补人手兵器；鸡足未定数，配图两足为解释。㤗保留捕获异体。"
    },
    {
      "source_unit_ids": [
        "source-03-0080",
        "source-03-0081",
        "source-03-0082",
        "source-03-0083",
        "source-03-0084"
      ],
      "basis": "0080—0081在84页，0081捕获85校回84；0082—0084在85页。彘耳及囂水缺字图按影印恢复，捕获标记另存。人目不是人面，四角与彘耳逐项核。檀柘之属为刚木郭注；鮨鱼犬首不改注中虎鹿猪首，音𭥍疑字依捕获保留。"
    },
    {
      "source_unit_ids": [
        "source-03-0085",
        "source-03-0086",
        "source-03-0087",
        "source-03-0088"
      ],
      "basis": "0085—0088全核85页；0088正文为空但郭注亦此𩔗承87，随本段保留。囂字缺图恢复，一首两身不加西山足翼。郭注𬋩子、蟡、八尺、取鱼龟不作正文形貌或现代灾害预测。"
    },
    {
      "source_unit_ids": [
        "source-03-0089"
      ],
      "basis": "0089全在85页，0090羆差另段仍待核。无草木与多葱韭并存，不擅改或漏录；北單不与單狐、單張混名。"
    },
    {
      "source_unit_ids": [
        "source-03-0090"
      ],
      "basis": "0090正文与野马小注均在85页末，捕获86校回85；0091北鮮另段。小型马体依郭注，体色姿态为艺术解释。"
    },
    {
      "source_unit_ids": [
        "source-03-0091",
        "source-03-0092"
      ],
      "basis": "0091—0092全核86页。西与北跨行连读作西北；郭注马出水中故事不当本山马形貌，不借羆差小马或求如水马图。"
    },
    {
      "source_unit_ids": [
        "source-03-0093",
        "source-03-0094",
        "source-03-0095"
      ],
      "basis": "0093—0095全核86页。狕音么独归兽名；䧑异体注独归山名。㤗澤复用獄法水文索引，保留东向与东北向来水区别。龍龜不补形。"
    },
    {
      "source_unit_ids": [
        "source-03-0096",
        "source-03-0097",
        "source-03-0098",
        "source-03-0099"
      ],
      "basis": "0096—0099全在86页，0099捕获87校回86。总括不计第26山。雄鷄彘瘞吉按原序留存，吉不擅删改，不擅定彘数量；不糈与郭注不用米分列。0099异文皆生食而不火另记。0100管涔开启次二列。"
    },
    {
      "source_unit_ids": [
        "source-03-0100",
        "source-03-0101",
        "source-03-0102"
      ],
      "basis": "0100—0102全核87页。临汾水上、音墳释枕汾；太原故汾阳北秀容山、音岑释管涔；至汾阳北西入河释汾水。古注不现代定位，跨列不补距离。0103少陽另段。"
    },
    {
      "source_unit_ids": [
        "source-03-0103",
        "source-03-0104",
        "source-03-0105"
      ],
      "basis": "0103—0105全在87页。0105正文空，但曰山上有赭者其下有鐵承0104管子；与0106縣雍分开。赤銀跨103—104连读，郭注银之精独归赤銀；不把少陽写作少咸。"
    },
    {
      "source_unit_ids": [
        "source-03-0106",
        "source-03-0107",
        "source-03-0108",
        "source-03-0109",
        "source-03-0110"
      ],
      "basis": "0106—0108在87页，0108捕获88校回87；0109—0110在88页。北唐以閭跨107—108连注，白𪂂注独归白䳑，不移给白翟。小魚曰儵不借帶山儵魚鸡形；赤麟字照录。不驕与或作騷騷臭也另存，不擅解为现代疗效。"
    },
    {
      "source_unit_ids": [
        "source-03-0111",
        "source-03-0112"
      ],
      "basis": "0111—0112全在88页。勝水东北注汾，蒼玉随水文记述；青碧、蒼玉不强定现代成分，狐岐名称不充当狐狸形貌。"
    },
    {
      "source_unit_ids": [
        "source-03-0113",
        "source-03-0114",
        "source-03-0115"
      ],
      "basis": "0113—0115全在88页。广員三百里照录，不擅换算圆直径面积；潜与郭注停其底分存，不强绘地下河道或定源流。鮪为水名，不据字义增鱼卡。"
    },
    {
      "source_unit_ids": [
        "source-03-0116"
      ],
      "basis": "0116全在88页。0117狂山虽捕获89页，实际起于88页末，留待下一阶段核；本段无水不与前后水域串联。"
    },
    {
      "source_unit_ids": [
        "source-03-0117",
        "source-03-0118"
      ],
      "basis": "0117在88页末，捕获89校回88；0118在89页。雪与狂水同归本段，不并爾是；浮水仅按本地水文建档，不混别篇同名。"
    },
    {
      "source_unit_ids": [
        "source-03-0119",
        "source-03-0120"
      ],
      "basis": "0119—0120全核89页。松栢分列，不补叶果图。旄水复用为諸餘—敦頭共享索引，不因同字合并潘侯旄牛。"
    },
    {
      "source_unit_ids": [
        "source-03-0121",
        "source-03-0122",
        "source-03-0123"
      ],
      "basis": "0121—0123全核89页。𩣡音勃独归兽名，马状体躯、姿态与蹄数属插画解释，正文白身一角牛尾逐项保留；旄水东注印澤，不改諸餘来水方向。"
    },
    {
      "source_unit_ids": [
        "source-03-0124",
        "source-03-0125",
        "source-03-0126",
        "source-03-0127"
      ],
      "basis": "0124—0126在89页，0126捕获90校回89；0127在90页仅郭注承前，归本段不并北囂。目在腋下不添脸眼；人𤓰依捕获异字保留。貪淋、還書等注文疑读照留，不作已校定字；不据饕餮名改画兽面纹器。"
    },
    {
      "source_unit_ids": [
        "source-03-0128",
        "source-03-0129",
        "source-03-0130",
        "source-03-0131",
        "source-03-0132"
      ],
      "basis": "0128—0132全核90页，北囂缺字图按影印恢复，捕获另存。音谷虽捕获在130仍归129獨𤞞；般冐两音归𪄀𪃑，或作夏也保留异文疑义。食用为古述；无石与碧玉不擅改。0133梁渠另段。"
    }
  ],
