  "commentary_alignment": [
    {
      "source_unit_ids": [
        "source-03-0002",
        "source-03-0003"
      ],
      "reading": "机木似榆可燒以糞稲田出蜀中音飢",
      "basis": "76页机木双行小注的音与飢连读；音逢另属漨水，捕获快照不改。"
    },
    {
      "source_unit_ids": [
        "source-03-0007",
        "source-03-0008",
        "source-03-0009",
        "source-03-0010"
      ],
      "basis": "0005—0009均见76页，0009牛尾及水马郭注捕获为77页，按影印校回76；0010其音如呼及注见77页，0011帶山另段。0008音吾子之吾回释前句梧，不归水馬；疣贅也释滑魚食用句。諸毗山只在郭注出现，单独作注文地点，不与西山同名山合并。周禮马黑脊等引文为比拟，不追加本段黑背特征；水马注录文省字或异写保留，非逐字校勘定本。"
    },
    {
      "source_unit_ids": [
        "source-03-0011",
        "source-03-0012",
        "source-03-0013",
        "source-03-0014",
        "source-03-0015",
        "source-03-0016"
      ],
      "basis": "0011—0016全核77页，0017譙明另段。䑏䟽一角有錯与郭注甲錯分列；鵸䳜注上已、有此鳥疑同名跨13—14连读，不合并西山三首六尾。儵魚郭注音由，英文采用Youyu，中文与稳定ID保留；不改为普通鱼形。"
    },
    {
      "source_unit_ids": [
        "source-03-0017",
        "source-03-0018",
        "source-03-0019",
        "source-03-0020",
        "source-03-0021"
      ],
      "basis": "0017—0018均见77页末，0018虽捕获78页仍校回77；0019—0021在78页。孟槐貆的豪猪释义来自郭注，不画成正文另称豪猪。多青与雄黄跨行连读，按青雄黄整项留歧义，一作多青碧另列，不擅改底本。"
    },
    {
      "source_unit_ids": [
        "source-03-0022",
        "source-03-0023",
        "source-03-0024",
        "source-03-0025"
      ],
      "basis": "0022—0025全核78页。鰼鰼十翼、鳞在羽端及鹊状同时保留，不据鱼名补鱼尾。㯶、栢、橿依底本；麢羊仅列名，蕃注未詳或云即鴞仍为不确定注说，二者用统一占位。"
    },
    {
      "source_unit_ids": [
        "source-03-0026",
        "source-03-0027",
        "source-03-0028",
        "source-03-0029"
      ],
      "basis": "0026—0027在78页，0027捕获79校回78；79页从注于河及橐駝续。桐梧与桐也跨26—27连读，后句椐樻木腫節中椐桾音祛独归椐，疑难用字不强解。橐駝注有肉鞍等不足决定驼峰数量，暂留占位；寓鼠状鸟翼有明确依据才生图。"
    },
    {
      "source_unit_ids": [
        "source-03-0030",
        "source-03-0031"
      ],
      "basis": "0030—0031全核79页，0032丹熏另段。魚水为水名，不将鱼字算作本段新增鱼类；文貝仅列名、玉与无石并存保留。河复用北山本批共享索引，四段摘句各存出处，不与西山河索引或现代河道合并。"
    },
    {
      "source_unit_ids": [
        "source-03-0032",
        "source-03-0033",
        "source-03-0034",
        "source-03-0035",
        "source-03-0036"
      ],
      "basis": "0032—0036全在79页，0036百毒捕获80校回79。皆山果爾雅有其名为捕获注文，所指不强解。正文莬首、以其尾飛保留；配图兔形首为艺术解释，或作髯飛属郭注异文，不并入正文。䐆大腹也与獋音豪分列。"
    },
    {
      "source_unit_ids": [
        "source-03-0037",
        "source-03-0038",
        "source-03-0039"
      ],
      "basis": "0037—0039全核80页，0040邊春另段。文題白身不可读成全身豹斑；題額也为郭注。河复用本篇共享索引，新增泚水出处，不与西山或现代河道合并。"
    },
    {
      "source_unit_ids": [
        "source-03-0040",
        "source-03-0041",
        "source-03-0042",
        "source-03-0043",
        "source-03-0048",
        "source-03-0049",
        "source-03-0050",
        "source-03-0051",
        "source-03-0052",
        "source-03-0053"
      ],
      "basis": "0040—0043全核80页。春山异名、葱茖大叶、桃小不解核、幽鴳佯眠与嬻嬒异文分开；不据鴳字补鸟形。杠水与后文櫟水相接，泑澤单设北山索引，不混單狐泑水和西山泑澤。"
    },
    {
      "source_unit_ids": [
        "source-03-0044",
        "source-03-0045",
        "source-03-0046",
        "source-03-0047"
      ],
      "basis": "0044—0045在80页，0045捕获81校回80；0046—0047在81页。足与訾跨页合名；足訾文臂、牛尾、马蹄分别核对。朋猶軰是郭注，群飞写入内容，鵁单体配图不冒充群景；音义注文的渇等疑字依捕获另存，不强解异文；雌雉羽色不借白鵺白翼黄足。"
    },
    {
      "source_unit_ids": [
        "source-03-0048",
        "source-03-0049",
        "source-03-0050",
        "source-03-0051",
        "source-03-0052",
        "source-03-0053"
      ],
      "basis": "0048—0053全核81页，0054灌題另段。諸犍复用既有稳定ID和图，保留旧篇目锚点，补本山出处；㗸字依捕获，不改写快照。嗌咽也谷梁傳曰嗌与下单元不容粒等连读；痸癡病也为古注，不按现代病种认定。櫟水南流不误作西流。"
    }
  ],
